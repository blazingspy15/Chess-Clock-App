{
  "expo": {
    "name": "Chess Clock Pro",
    "slug": "chess-clock-pro",
    "version": "1.0.2",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0c0e12"
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0c0e12",
      "translucent": false
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chessclock.pro",
      "infoPlist": {
        "UIRequiresFullScreen": true
      }
    },
    "android": {
      "package": "com.chessclock.pro",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0c0e12"
      }
    },
    "plugins": [
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "baseUrl": "/Chess-Clock-App"
    }
  }
}
